# /etc/systemd/system/beehive-subscriber.service
[Unit]
Description=Beehive MQTT Subscriber
After=network.target mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/beehive
ExecStart=/usr/bin/python3 /home/pi/beehive/subscriber.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target